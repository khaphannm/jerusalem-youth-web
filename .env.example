# Web development environment
# Copy this file to .env.local, then run `npm run dev` from the repository root.
# Start the CMS first so it is available at this server-only origin.
CMS_BASE_URL=http://localhost:1337

# Development-only bearer secret for POST /api/revalidate. Use this same value
# in the Strapi publication webhook's Authorization header:
#   Bearer local-development-revalidation-secret-change-me
# Replace it with a generated secret in every shared or deployed environment.
# Never use a NEXT_PUBLIC_ prefix for this value.
CMS_REVALIDATION_SECRET=local-development-revalidation-secret-change-me
