{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "Home Page",
    "description": "Landing-page copy. Hero photographs are managed in Site Settings."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "heroHeadline": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "heroDescription": {
      "type": "text",
      "required": true,
      "maxLength": 400
    },
    "primaryCta": {
      "type": "component",
      "repeatable": false,
      "required": true,
      "component": "shared.cta"
    },
    "introduction": {
      "type": "component",
      "repeatable": false,
      "required": true,
      "component": "shared.section-intro"
    },
    "community": {
      "type": "component",
      "repeatable": false,
      "required": true,
      "component": "shared.section-intro"
    },
    "communityThemes": {
      "type": "component",
      "repeatable": true,
      "required": true,
      "min": 1,
      "max": 6,
      "component": "shared.ministry-value"
    },
    "gathering": {
      "type": "component",
      "repeatable": false,
      "required": true,
      "component": "shared.section-intro"
    },
    "gatheringEmptyMessage": {
      "type": "text",
      "required": true,
      "maxLength": 400
    },
    "stories": {
      "type": "component",
      "repeatable": false,
      "required": true,
      "component": "shared.section-intro"
    },
    "teaching": {
      "type": "component",
      "repeatable": false,
      "required": true,
      "component": "shared.section-intro"
    },
    "newcomer": {
      "type": "component",
      "repeatable": false,
      "required": true,
      "component": "shared.section-intro"
    },
    "newcomerSteps": {
      "type": "component",
      "repeatable": true,
      "required": true,
      "min": 1,
      "max": 4,
      "component": "shared.ministry-value"
    },
    "invitation": {
      "type": "component",
      "repeatable": false,
      "required": true,
      "component": "shared.section-intro"
    }
  }
}
