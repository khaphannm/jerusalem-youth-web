{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Settings"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "heroSlides": {
      "type": "component",
      "repeatable": true,
      "component": "shared.hero-slide",
      "max": 5
    },
    "siteName": {
      "type": "string",
      "required": true
    },
    "siteDescription": {
      "type": "text",
      "required": true
    },
    "defaultSeo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "defaultSocialImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "organizationContact": {
      "type": "component",
      "repeatable": false,
      "component": "shared.contact"
    },
    "primaryCta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.cta"
    },
    "footerContent": {
      "type": "blocks"
    }
  }
}
