{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "singularName": "event",
    "pluralName": "events",
    "displayName": "Event"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text",
      "required": true
    },
    "description": {
      "type": "blocks",
      "required": true
    },
    "banner": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "startDateTime": {
      "type": "datetime",
      "required": true
    },
    "endDateTime": {
      "type": "datetime"
    },
    "locationName": {
      "type": "string",
      "required": true
    },
    "address": {
      "type": "text"
    },
    "mapURL": {
      "type": "string"
    },
    "registrationURL": {
      "type": "string"
    },
    "registrationDeadline": {
      "type": "datetime"
    },
    "contactName": {
      "type": "string"
    },
    "contactLink": {
      "type": "string"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
