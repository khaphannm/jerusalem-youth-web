# CMS development environment
# Copy this file to cms/.env. Values marked development-only must never be used
# in a shared, staging, or production environment.

# Local Strapi server
HOST=0.0.0.0
PORT=1337

# Development-only Strapi secrets. Generate independent random values before
# using the CMS outside an isolated local machine.
APP_KEYS=local-development-app-key-1,local-development-app-key-2,local-development-app-key-3,local-development-app-key-4
API_TOKEN_SALT=local-development-api-token-salt
ADMIN_JWT_SECRET=local-development-admin-jwt-secret
TRANSFER_TOKEN_SALT=local-development-transfer-token-salt
ENCRYPTION_KEY=local-development-encryption-key
JWT_SECRET=local-development-users-permissions-jwt-secret

# Local PostgreSQL. These values match the development container command in
# cms/README.md. Alternatively, comment out the discrete connection values and
# set DATABASE_URL to a PostgreSQL connection string.
DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://strapi:strapi-local@localhost:5432/jerusalem_youth
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=jerusalem_youth
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi-local
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# Development uses Strapi's local upload provider. Production S3/CDN variables
# are intentionally omitted here; see cms/docs/media-permissions-operations.md.

# The publication webhook does not need populated relations for cache
# revalidation. Configure its URL and the shared bearer secret in Strapi Admin.
WEBHOOKS_POPULATE_RELATIONS=false
